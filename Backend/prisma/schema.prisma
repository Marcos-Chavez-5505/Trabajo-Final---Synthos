generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique @db.VarChar(255)
  username            String             @unique @db.VarChar(50)
  passwordHash        String             @map("password_hash") @db.VarChar(255)
  pictureUrl          String?            @map("picture_url")
  biography           String?
  registrationDate    DateTime           @default(now()) @map("registration_date") @db.Timestamp(6)
  contents            Content[]
  contentPlayements   ContentPlayement[]
  favorites           Favorite[]
  followers           Follow[]           @relation("Followed")
  following           Follow[]           @relation("Follower")
  ratingsReceived     HostRating[]       @relation("Host")
  ratingsGiven        HostRating[]       @relation("Rater")
  playlistsCreated    Playlist[]
  playlistMemberships PlaylistMember[]
  playlistSongsAdded  PlaylistSong[]
  roomMemberships     RoomMember[]

  @@map("user")
}

model Artist {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(150)
  songs       Song[]
  songArtists SongArtist[]

  @@map("artist")
}

model Song {
  id            Int            @id @default(autoincrement())
  title         String         @db.VarChar(200)
  idArtist      Int            @map("id_artist")
  releaseDate   DateTime?      @map("release_date") @db.Date
  coverUrl      String?        @map("cover_url")
  duration      Int?
  url           String
  contents      Content[]
  favorites     Favorite[]
  playlistSongs PlaylistSong[]
  artist        Artist         @relation(fields: [idArtist], references: [id])
  songArtists   SongArtist[]
  songGenres    SongGenre[]
  songMoods     SongMood[]

  @@map("song")
}

model SongArtist {
  idSong   Int    @map("id_song")
  idArtist Int    @map("id_artist")
  artist   Artist @relation(fields: [idArtist], references: [id], onDelete: Cascade)
  song     Song   @relation(fields: [idSong], references: [id], onDelete: Cascade)

  @@id([idSong, idArtist])
  @@map("song_artist")
}

model Genre {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(80)
  songGenres SongGenre[]

  @@map("genre")
}

model SongGenre {
  idSong  Int   @map("id_song")
  idGenre Int   @map("id_genre")
  genre   Genre @relation(fields: [idGenre], references: [id], onDelete: Cascade)
  song    Song  @relation(fields: [idSong], references: [id], onDelete: Cascade)

  @@id([idSong, idGenre])
  @@map("song_genre")
}

model Mood {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(80)
  songMoods SongMood[]

  @@map("mood")
}

model SongMood {
  idSong Int  @map("id_song")
  idMood Int  @map("id_mood")
  mood   Mood @relation(fields: [idMood], references: [id], onDelete: Cascade)
  song   Song @relation(fields: [idSong], references: [id], onDelete: Cascade)

  @@id([idSong, idMood])
  @@map("song_mood")
}

model Playlist {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(150)
  description     String?
  idCreator       Int              @map("id_creator")
  type            PlaylistType
  isPublic        Boolean          @default(false) @map("is_public")
  tokenInvitation String?          @map("token_invitation") @db.VarChar(255)
  creationDate    DateTime         @default(now()) @map("creation_date") @db.Timestamp(6)
  creator         User             @relation(fields: [idCreator], references: [id], onDelete: Cascade)
  members         PlaylistMember[]
  songs           PlaylistSong[]
  rooms           Room[]

  @@map("playlist")
}

model PlaylistMember {
  idPlaylist Int          @map("id_playlist")
  idUser     Int          @map("id_user")
  role       PlaylistRole
  joinDate   DateTime     @default(now()) @map("join_date") @db.Timestamp(6)
  playlist   Playlist     @relation(fields: [idPlaylist], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [idUser], references: [id], onDelete: Cascade)

  @@id([idPlaylist, idUser])
  @@map("playlist_member")
}

model PlaylistSong {
  idPlaylist Int      @map("id_playlist")
  idSong     Int      @map("id_song")
  position   Int
  addedDate  DateTime @default(now()) @map("added_date") @db.Timestamp(6)
  addedBy    Int?     @map("added_by")
  user       User?    @relation(fields: [addedBy], references: [id])
  playlist   Playlist @relation(fields: [idPlaylist], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [idSong], references: [id], onDelete: Cascade)

  @@id([idPlaylist, idSong])
  @@map("playlist_song")
}

model Favorite {
  idUser     Int      @map("id_user")
  idSong     Int      @map("id_song")
  markedDate DateTime @default(now()) @map("marked_date") @db.Timestamp(6)
  song       Song     @relation(fields: [idSong], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [idUser], references: [id], onDelete: Cascade)

  @@id([idUser, idSong])
  @@map("favorite")
}

model Follow {
  followerId Int      @map("follower_id")
  followedId Int      @map("followed_id")
  followDate DateTime @default(now()) @map("follow_date") @db.Timestamp(6)
  followed   User     @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@map("follow")
}

model Content {
  id         Int                @id @default(autoincrement())
  idAuthor   Int                @map("id_author")
  text       String
  idSong     Int?               @map("id_song")
  date       DateTime           @default(now()) @db.Timestamp(6)
  author     User               @relation(fields: [idAuthor], references: [id], onDelete: Cascade)
  song       Song?              @relation(fields: [idSong], references: [id], onDelete: Cascade)
  playements ContentPlayement[]

  @@map("content")
}

model ContentPlayement {
  idContent Int     @map("id_content")
  idUser    Int     @map("id_user")
  content   Content @relation(fields: [idContent], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [idUser], references: [id], onDelete: Cascade)

  @@id([idContent, idUser])
  @@map("content_playement")
}

model Room {
  id               Int          @id @default(autoincrement())
  code             String       @unique @db.VarChar(20)
  name             String       @db.VarChar(150)
  description      String?
  idPlaylistSource Int          @map("id_playlist_source")
  isPrivate        Boolean      @default(false) @map("is_private")
  passwordHash     String?      @map("password_hash") @db.VarChar(255)
  maxCapacity      Int          @map("max_capacity")
  status           RoomStatus
  creationDate     DateTime     @default(now()) @map("creation_date") @db.Timestamp(6)
  expiresAt        DateTime?    @map("expires_at") @db.Timestamp(6)
  ratings          HostRating[]
  playlistSource   Playlist     @relation(fields: [idPlaylistSource], references: [id])
  members          RoomMember[]

  @@map("room")
}

model RoomMember {
  idRoom   Int      @map("id_room")
  idUser   Int      @map("id_user")
  role     RoomRole
  joinDate DateTime @default(now()) @map("join_date") @db.Timestamp(6)
  room     Room     @relation(fields: [idRoom], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [idUser], references: [id], onDelete: Cascade)

  @@id([idRoom, idUser])
  @@map("room_member")
}

model HostRating {
  idRoom     Int      @map("id_room")
  idRater    Int      @map("id_rater")
  idHost     Int      @map("id_host")
  rating     Int      @db.SmallInt
  ratingDate DateTime @default(now()) @map("rating_date") @db.Timestamp(6)
  host       User     @relation("Host", fields: [idHost], references: [id], onDelete: Cascade)
  rater      User     @relation("Rater", fields: [idRater], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [idRoom], references: [id], onDelete: Cascade)

  @@id([idRoom, idRater, idHost])
  @@map("host_rating")
}

view user_genre_counts {
  id_user    Int?
  id_genre   Int?
  song_count BigInt?
}

view user_top_genre {
  id_user    Int?
  id_genre   Int?
  genre_name String? @db.VarChar(80)
  song_count BigInt?
}

enum PlaylistType {
  personal
  colab
  favorites
  
  @@map("playlist_type")
}

enum PlaylistRole {
  creator
  colaborator

  @@map("playlist_role")
}

enum RoomRole {
  host
  member

  @@map("room_role")
}

enum RoomStatus {
  activa
  cerrada

  @@map("room_status")
}
