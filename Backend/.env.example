POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
DATABASE_URL=""

PGADMIN_DEFAULT_EMAIL=""
PGADMIN_DEFAULT_PASSWORD=""
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Presencia de salas: tiempo (ms) que un usuario sigue contando como presente
# después de cerrar su último socket. Vacío = 60000.
ROOM_PRESENCE_GRACE_MS=""

# Sala en vivo: tiempo (ms) sin sockets de la anfitriona antes de pausar la
# reproducción. Vacío = 120000.
ROOM_HOST_OFFLINE_PAUSE_MS=""

# Expulsión por inactividad: tiempo (ms) que la sala puede estar OFF antes de
# expulsar a los invitados no conectados (la anfitriona nunca se expulsa).
# Vacío = 1800000.
ROOM_INACTIVE_EXPEL_MS=""

# Cada cuánto (ms) corre el job de inactividad. Vacío = 60000.
ROOM_INACTIVITY_JOB_INTERVAL_MS=""

# TTL (ms) de la caché de géneros por sala. Se invalida igual al cambiar la
# playlist asociada; esto es solo la red de seguridad. Vacío = 300000.
ROOM_GENRES_CACHE_TTL_MS=""

# Debounce (ms) del evento room:card-updated por sala hacia el lobby.
# Vacío = 1500.
ROOM_CARD_DEBOUNCE_MS=""

# TTL (ms) del marcador en memoria que recuerda que una expulsión fue por
# inactividad (solo para el mensaje de la UI). Se pierde al reiniciar el
# backend. Vacío = 86400000 (24 h); 0 lo desactiva.
ROOM_EXPULSION_MARKER_TTL_MS=""

IMAGEKIT_PRIVATE_KEY=""
